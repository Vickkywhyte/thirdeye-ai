# ===========================================
# ThirdEye AI — Environment Variables
# Copy to .env.local and fill in values
# ===========================================

# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI / LLM ─────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=

# ── External Data Sources ─────────────────
COMPANIES_HOUSE_API_KEY=
NEWSAPI_API_KEY=
# Required for PEP screening — api.opensanctions.org returns 401 without it
OPENSANCTIONS_API_KEY=

# AI models. Must match a model actually available to each provider:
# Ollama -> `ollama list`; OpenRouter -> https://openrouter.ai/models
OLLAMA_MODEL=llama3
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct

# ── Application ───────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# ── Cron (periodic reviews, portfolio monitoring) ─────────
# Shared secret for scheduler → /api/cron/* routes.
# Required in production so unauthenticated callers can't trigger cron work.
# Scheduler must send: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# ── Feature Flags ─────────────────────────
FEATURE_AI_ANALYSIS=true
FEATURE_PDF_EXPORT=true
FEATURE_OWNERSHIP_GRAPH=true
FEATURE_ADVERSE_MEDIA=true

# ── Optional (production) ─────────────────
# GRAFANA_CLOUD_API_KEY=
# RESEND_API_KEY=
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=
# SENTRY_DSN=
